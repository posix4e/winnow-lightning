#!/bin/bash
# Rebuild every app slice from the same locked source. WalletCore never links this.
set -euo pipefail
ROOT=$(cd "$(dirname "$0")/.." && pwd)
cd "$ROOT/TorBridge"
"$ROOT/scripts/render-tor-notices" --check
command -v rustup >/dev/null || { echo 'rustup is required for app Tor builds' >&2; exit 1; }
rustup toolchain install 1.97.1 --profile minimal
rustup target add --toolchain 1.97.1 aarch64-apple-ios aarch64-apple-ios-sim x86_64-apple-ios
python3 - <<'PY'
import tomllib
with open('Cargo.lock', 'rb') as f:
    packages = tomllib.load(f)['package']
assert all(p['version'] == '0.46.0' for p in packages if p['name'].startswith('tor-') or p['name'] == 'arti-client'), 'Tor crate versions must match'
PY
export IPHONEOS_DEPLOYMENT_TARGET=17.0
for target in aarch64-apple-ios aarch64-apple-ios-sim x86_64-apple-ios; do
    cargo build --locked --release --target "$target"
done
mkdir -p build/simulator
lipo -create target/aarch64-apple-ios-sim/release/libwinnow_tor.a \
    target/x86_64-apple-ios/release/libwinnow_tor.a -output build/simulator/libwinnow_tor.a
# Only generated output is replaced; source and app-owned Tor state are untouched.
rm -rf build/WinnowTor.xcframework
xcodebuild -create-xcframework \
    -library target/aarch64-apple-ios/release/libwinnow_tor.a -headers include \
    -library build/simulator/libwinnow_tor.a -headers include \
    -output build/WinnowTor.xcframework
shasum -a 256 Cargo.lock target/aarch64-apple-ios/release/libwinnow_tor.a \
    build/simulator/libwinnow_tor.a > build/source-and-binary-sha256.txt
