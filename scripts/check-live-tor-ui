#!/bin/bash
# Explicit public-network release check. Use a dedicated simulator or paired
# iPhone, after building the locked XCFramework with scripts/build-tor-bridge.
set -euo pipefail
cd "$(dirname "$0")/.."
destination="${1:?usage: check-live-tor-ui <Xcode destination> <new evidence directory>}"
evidence="${2:?a new evidence directory is required}"
mkdir "$evidence"
evidence="$(cd "$evidence" && pwd)"
export TEST_RUNNER_WINNOW_LIVE_TOR_UI=1
xcodebuild -project WinnowApp.xcodeproj -scheme WinnowApp \
  -destination "$destination" -derivedDataPath "$evidence/DerivedData" \
  -resultBundlePath "$evidence/LiveTor.xcresult" \
  -only-testing:WinnowAppUITests/LiveTorDeviceTests \
  -parallel-testing-enabled NO -allowProvisioningUpdates test \
  2>&1 | tee "$evidence/live-tor.log"
