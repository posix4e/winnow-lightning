#!/bin/bash
# Pinned official rustup bootstrap, needed only to build the app-owned Tor bridge.
set -euo pipefail
export PATH="$HOME/.cargo/bin:$PATH"
if ! command -v rustup >/dev/null; then
    case "$(uname -m)" in
      arm64) host=aarch64-apple-darwin; digest=20ef5516c31b1ac2290084199ba77dbbcaa1406c45c1d978ca68558ef5964ef5 ;;
      x86_64) host=x86_64-apple-darwin; digest=9c331076f62b4d0edeae63d9d1c9442d5fe39b37b05025ec8d41c5ed35486496 ;;
      *) echo 'Unsupported app build host' >&2; exit 1 ;;
    esac
    temporary=$(mktemp -d)
    trap 'rm -rf "$temporary"' EXIT
    curl -fsSL --max-time 120 "https://static.rust-lang.org/rustup/archive/1.28.2/$host/rustup-init" -o "$temporary/rustup-init"
    actual=$(shasum -a 256 "$temporary/rustup-init" | cut -d ' ' -f1)
    [[ "$actual" == "$digest" ]] || { echo 'rustup checksum mismatch' >&2; exit 1; }
    chmod +x "$temporary/rustup-init"
    "$temporary/rustup-init" -y --no-modify-path --profile minimal --default-toolchain none
fi
if [[ -n "${GITHUB_PATH:-}" ]]; then echo "$HOME/.cargo/bin" >> "$GITHUB_PATH"; fi
rustup toolchain install 1.97.1 --profile minimal
