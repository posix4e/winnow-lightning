#!/usr/bin/env python3
"""Verify reviewed, locked license evidence and render bundled notices offline."""
import argparse
import hashlib
import html
import json
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent / "TorBridge"


def checked_inventory():
    data = json.loads((ROOT / "license-inventory.json").read_text())
    assert data["schemaVersion"] == 1, "unknown license inventory schema"
    assert data["cargoLockSHA256"] == hashlib.sha256((ROOT / "Cargo.lock").read_bytes()).hexdigest(), "review licenses after updating Cargo.lock"
    notices = {}
    for item in data["notices"]:
        assert item["file"] == item["sha256"] + ".txt"
        raw = (ROOT / "license-sources" / item["file"]).read_bytes()
        assert hashlib.sha256(raw).hexdigest() == item["sha256"], "license evidence changed"
        notices[item["sha256"]] = (item["source"], raw.decode("utf-8").replace("\r\n", "\n").replace("\r", "\n"))
    assert all(p["notices"] and set(p["notices"]) <= notices.keys() for p in data["packages"])
    return data, notices


def render():
    data, notices = checked_inventory()
    sections = ["Winnow Tor bridge — third-party notices", "Generated from the reviewed license-inventory.json and the exact Cargo.lock.\nIncludes dependencies selected for supported iOS targets, including build tools."]
    for digest, (source, notice) in sorted(notices.items()):
        packages = [p for p in data["packages"] if digest in p["notices"]]
        names = [p["name"] + " " + p["version"] + " (" + p["license"] + ")" for p in packages]
        sections.append("\n".join(names) + "\n\nSource: " + source + "\n\n" + "\n".join(line.rstrip() for line in notice.splitlines()))
    text = "\n\n".join(sections) + "\n"
    page = '''<!doctype html><html lang="en"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta http-equiv="Content-Security-Policy" content="default-src 'none'; style-src 'unsafe-inline'"><title>Tor licenses</title><style>body{font:15px system-ui;margin:24px;color-scheme:light dark}pre{white-space:pre-wrap;overflow-wrap:anywhere}</style><body><pre>''' + html.escape(text) + '</pre></body></html>\n'
    return {"THIRD_PARTY_NOTICES.txt": text, "tor-licenses.html": page}


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--check", action="store_true")
    args = parser.parse_args()
    for name, text in render().items():
        path = ROOT / name
        if args.check:
            assert path.exists() and path.read_text() == text, "run scripts/render-tor-notices: " + name
        else:
            path.write_text(text)
    print("Tor license inventory, source hashes and bundled notices verified")


if __name__ == "__main__":
    main()
