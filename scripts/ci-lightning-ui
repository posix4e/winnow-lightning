#!/usr/bin/env python3
"""Build once, record the real Lightning UI journey, retain independent evidence."""
import argparse
import hashlib
import json
import os
from pathlib import Path
import plistlib
import signal
import subprocess
import time

ROOT = Path(__file__).resolve().parent.parent


def run(args, log, env=None, timeout=None):
    with log.open('w') as out:
        subprocess.run(args, cwd=ROOT, stdout=out, stderr=subprocess.STDOUT, env=env, check=True, timeout=timeout)


def prepare_display(simulator, results):
    # bootstatus can finish on a cold hosted runner without recordVideo ever
    # receiving a display frame. Render a system app through simctl
    # before starting the recorder. Do not launch Winnow until recording is
    # acknowledged, so onboarding and every financial action remain captured.
    run(['xcrun', 'simctl', 'launch', simulator, 'com.apple.Preferences'],
        results / 'display-launch.log', timeout=60)
    run(['xcrun', 'simctl', 'io', simulator, 'screenshot', str(results / 'display-ready.png')],
        results / 'display-screenshot.log', timeout=60)
    assert (results / 'display-ready.png').stat().st_size > 0, 'simulator display produced no screenshot'
    print('Lightning UI simulator display ready', flush=True)


def wait(check, seconds=90):
    deadline = time.monotonic() + seconds
    while time.monotonic() < deadline:
        if check():
            return
        time.sleep(0.2)
    raise TimeoutError('Lightning UI prerequisite did not become ready')


def stop(process, sig=signal.SIGTERM):
    if process and process.poll() is None:
        process.send_signal(sig)
        try:
            process.wait(timeout=30)
        except subprocess.TimeoutExpired:
            process.kill()
            process.wait(timeout=10)
            raise


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument('results', type=Path)
    parser.add_argument('--skip-build', action='store_true')
    args = parser.parse_args()
    results = args.results.resolve()
    results.mkdir(parents=True, exist_ok=False)
    simulator = os.environ.get('SIMULATOR_ID') or subprocess.check_output([str(ROOT / 'scripts/ios-simulator'), 'iPhone'], text=True).strip()
    derived = Path(os.environ.get('DERIVED_DATA', results / 'derived-data')).resolve()
    run(['swift', 'build', '--product', 'winnow-lightning-peer-fixture'], results / 'host-build.log')
    if not args.skip_build:
        run(['xcodegen', 'generate'], results / 'project.log')
        run(['xcodebuild', 'build-for-testing', '-project', 'WinnowApp.xcodeproj', '-scheme', 'WinnowLightning', '-configuration', 'ResearchDebug',
             '-destination', f'platform=iOS Simulator,id={simulator}', '-derivedDataPath', str(derived),
             '-skipPackagePluginValidation', '-skipMacroValidation'], results / 'app-build.log')
    specifications = list((derived / 'Build/Products').glob('WinnowLightning_*.xctestrun'))
    assert len(specifications) == 1, specifications
    with specifications[0].open('rb') as file:
        specification = plistlib.load(file)
    products = derived / 'Build/Products'
    app = products / 'ResearchDebug-iphonesimulator/WinnowApp.app'
    info = plistlib.loads((app / 'Info.plist').read_bytes())
    assert info['CFBundleIdentifier'] == 'com.btcswift.lightning'
    binary = app / info['CFBundleExecutable']
    run(['xcrun', 'simctl', 'bootstatus', simulator, '-b'], results / 'simulator.log')
    prepare_display(simulator, results)
    devices = json.loads(subprocess.check_output(['xcrun', 'simctl', 'list', 'devices', '--json'], text=True))['devices']
    identity = next(dict(name=device['name'], device_type=device['deviceTypeIdentifier'], runtime=runtime)
                    for runtime, entries in devices.items() for device in entries if device['udid'] == simulator)
    manifest = dict(source=subprocess.check_output(['git', 'rev-parse', 'HEAD'], cwd=ROOT, text=True).strip(),
                    dirty=bool(subprocess.check_output(['git', 'status', '--porcelain'], cwd=ROOT, text=True).strip()),
                    simulator=simulator, bundle=info['CFBundleIdentifier'],
                    executable_sha256=hashlib.sha256(binary.read_bytes()).hexdigest(),
                    xcode=subprocess.check_output(['xcodebuild', '-version'], text=True).strip(),
                    device=identity,
                    content_size=subprocess.check_output(['xcrun', 'simctl', 'ui', simulator, 'content_size'], text=True).strip(),
                    scope='ResearchDebug regtest fixture; physical authentication is a separate release gate')
    (results / 'manifest.json').write_text(json.dumps(manifest, indent=2) + '\n')
    def absolute(value):
        if isinstance(value, str):
            return value.replace('__TESTROOT__', str(products))
        if isinstance(value, list):
            return [absolute(item) for item in value]
        if isinstance(value, dict):
            return {key: absolute(item) for key, item in value.items()}
        return value
    specification = absolute(specification)
    if 'TestConfigurations' in specification:
        targets = [target for configuration in specification['TestConfigurations'] for target in configuration['TestTargets']]
    else:
        targets = [value for key, value in specification.items() if not key.startswith('__')]
    for target in targets:
        target.setdefault('EnvironmentVariables', {}).update(
            WINNOW_LIGHTNING_UI_FIXTURE=str(results / 'fixture/connection.json'),
            WINNOW_SCREENSHOT_DIR=str(results / 'screenshots'))
    spec = results / 'Lightning.xctestrun'
    with spec.open('wb') as file:
        plistlib.dump(specification, file)
    fixture = video = None
    try:
        with (results / 'fixture.log').open('w') as log:
            fixture = subprocess.Popen([str(ROOT / 'scripts/lightning-ui-fixture'), str(results / 'fixture'), '--simulator', simulator,
                                        '--bundle', info['CFBundleIdentifier']],
                                       cwd=ROOT, stdout=log, stderr=subprocess.STDOUT)
        def fixture_ready():
            assert fixture.poll() is None, 'fixture exited'
            return (results / 'fixture/connection.json').is_file()
        wait(fixture_ready, 180)
        with (results / 'video.log').open('w') as log:
            video = subprocess.Popen(['xcrun', 'simctl', 'io', simulator, 'recordVideo', '--codec=h264', str(results / 'journey.mp4')],
                                     stdout=log, stderr=subprocess.STDOUT)
        def recording():
            assert video.poll() is None, 'recorder exited'
            return 'Recording started' in (results / 'video.log').read_text()
        wait(recording, 60)
        print('Lightning UI recording acknowledged; starting XCTest', flush=True)
        run(['xcodebuild', 'test-without-building', '-xctestrun', str(spec),
             '-destination', f'platform=iOS Simulator,id={simulator}', '-only-testing:WinnowAppUITests/LightningAppUITests',
             '-test-timeouts-enabled', 'YES', '-maximum-test-execution-time-allowance', '900',
             '-resultBundlePath', str(results / 'LightningUI.xcresult')], results / 'ui-tests.log')
        receipt = json.loads((results / 'fixture/evidence/receipt.json').read_text())
        assert receipt['result'] == 'passed'
    finally:
        try:
            if video:
                stop(video, signal.SIGINT)
                assert video.returncode == 0 and (results / 'journey.mp4').stat().st_size > 0
        finally:
            stop(fixture)
    # Only a successful XCTest result AND a finalized recording produce this
    # receipt. Provider receipts alone do not prove that the app checks passed.
    completed = dict(result='passed', manifest=manifest,
        video_sha256=hashlib.sha256((results / 'journey.mp4').read_bytes()).hexdigest(),
        independent_receipt_sha256=hashlib.sha256((results / 'fixture/evidence/receipt.json').read_bytes()).hexdigest())
    (results / 'journey.json').write_text(json.dumps(completed, indent=2) + '\n')
    print('PASS: recorded Swift app async payment, process crashes and returned channel funds', flush=True)


if __name__ == '__main__':
    main()
