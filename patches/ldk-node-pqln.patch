+	/// Require a fresh regtest invoice with a valid PQLN signature bound to the pinned key.
+	pub fn verify_pq_invoice(&self, invoice_text: String, trusted_key: Vec<u8>) -> Result<(), Error> {
+		use lightning::ln::invoice_utils::{verify_bolt11_pq_signature, Bolt11PqVerification};
+		let trusted_key: [u8; lightning::sign::pq::PQ_PUBLIC_KEY_LEN] =
+			trusted_key.try_into().map_err(|_| Error::InvalidPublicKey)?;
+		let invoice: lightning_invoice::Bolt11Invoice =
+			invoice_text.trim().parse().map_err(|_| Error::InvalidInvoice)?;
+		if invoice.currency() != lightning_invoice::Currency::Regtest || invoice.is_expired() {
+			return Err(Error::InvalidInvoice);
+		}
+		match verify_bolt11_pq_signature(&invoice, Some(&trusted_key), self.logger.as_ref()) {
+			Bolt11PqVerification::Verified => Ok(()),
+			_ => Err(Error::InvalidInvoice),
+		}
+	}
