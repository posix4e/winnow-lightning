index 0000000..d7fcabe
--- /dev/null
+++ b/src/chain/p2p.rs
@@ -0,0 +1,505 @@
+// Regtest-only direct Bitcoin peer backend using BIP 157/158 compact filters.
+use std::collections::{HashMap, HashSet};
+use std::io;
+use std::net::SocketAddr;
+use std::path::Path;
+use std::sync::atomic::{AtomicBool, AtomicU64, Ordering};
+use std::sync::{Arc, Mutex, RwLock};
+use std::time::Duration;
+
+use bip157::{Builder as PeerBuilder, Client, Event, IndexedFilter, Package, Requester};
+use bitcoin::bip158::BlockFilter;
+use bitcoin::consensus::{deserialize, serialize};
+use bitcoin::hashes::sha256d;
+use bitcoin::hashes::Hash;
+use bitcoin::pow::Work;
+use bitcoin::{BlockHash, FeeRate, Network, ScriptBuf};
+use lightning::chain::{BlockLocator, Confirm, Listen};
+use lightning_block_sync::init::synchronize_listeners;
+use lightning_block_sync::poll::{ChainPoller, ChainTip, ValidatedBlockHeader};
+use lightning_block_sync::{BlockData, BlockHeaderData, BlockSource, BlockSourceError, SpvClient};
+use rusqlite::{params, Connection, OptionalExtension};
+
+use super::{WalletSyncGuard, WalletSyncStatus};
+use crate::config::Config;
+use crate::fee_estimator::{apply_post_estimation_adjustments, get_all_conf_targets, OnchainFeeEstimator};
+use crate::logger::{log_error, log_info, LdkLogger, Logger};
+use crate::runtime::Runtime;
+use crate::tx_broadcaster::SortedTransactions;
+use crate::types::{ChainMonitor, ChannelManager, Sweeper, Wallet};
+use crate::Error;
+
+const REQUEST_TIMEOUT: Duration = Duration::from_secs(15);
+const RETRY_DELAY: Duration = Duration::from_secs(2);
+
+type PeerSpvClient = SpvClient<ChainPoller<Arc<PeerBlockSource>, PeerBlockSource>, Arc<ChainListener>>;
+
+// All records come from Kyoto's filter events, after its two-peer filter-header
+// agreement and filter-hash check. Keep both branches of a reorganization; reads
+// of historical matches are checked against the current canonical header.
+struct FilterHistory(Mutex<Connection>);
+
+impl FilterHistory {
+	fn open(storage_dir: &str) -> rusqlite::Result<Self> {
+		let path = Path::new(storage_dir).join("compact-filter-history.sqlite");
+		let connection = Connection::open(path)?;
+		connection.execute_batch("PRAGMA journal_mode=WAL; PRAGMA synchronous=FULL;
+			CREATE TABLE IF NOT EXISTS filters (
+				block_hash BLOB PRIMARY KEY NOT NULL,
+				height INTEGER NOT NULL,
+				header BLOB NOT NULL,
+				filter_hash BLOB NOT NULL,
+				contents BLOB NOT NULL
+			);
+			CREATE INDEX IF NOT EXISTS filters_height ON filters(height);")?;
+		Ok(Self(Mutex::new(connection)))
+	}
+
+	fn insert(&self, filter: IndexedFilter) -> rusqlite::Result<()> {
+		let height = filter.height();
+		let hash = filter.block_hash();
+		let (header, filter) = filter.into_parts();
+		let filter_hash = sha256d::Hash::hash(&filter.content);
+		self.0.lock().expect("lock").execute(
+			"INSERT OR REPLACE INTO filters(block_hash, height, header, filter_hash, contents) VALUES(?1, ?2, ?3, ?4, ?5)",
+			params![hash.to_byte_array().as_slice(), height, serialize(&header), filter_hash.to_byte_array().as_slice(), filter.content],
+		)?;
+		Ok(())
+	}
+
+	fn get(&self, hash: &BlockHash) -> rusqlite::Result<Option<(bitcoin::block::Header, BlockFilter)>> {
+		let raw: Option<(Vec<u8>, Vec<u8>, Vec<u8>)> = self.0.lock().expect("lock").query_row(
+			"SELECT header, filter_hash, contents FROM filters WHERE block_hash=?1",
+			params![hash.to_byte_array().as_slice()], |row| Ok((row.get(0)?, row.get(1)?, row.get(2)?)),
+		).optional()?;
+		raw.map(|(header, stored_hash, contents)| {
+			let header = deserialize::<bitcoin::block::Header>(&header)
+				.map_err(|_| rusqlite::Error::InvalidQuery)?;
+			if header.block_hash() != *hash { return Err(rusqlite::Error::InvalidQuery); }
+			if sha256d::Hash::hash(&contents).to_byte_array().as_slice() != stored_hash {
+				return Err(rusqlite::Error::InvalidQuery);
+			}
+			Ok((header, BlockFilter::new(&contents)))
+		}).transpose()
+	}
+
+	fn matches(&self, scripts: &[ScriptBuf], tip: u32) -> rusqlite::Result<Vec<(u32, BlockHash)>> {
+		let connection = self.0.lock().expect("lock");
+		let mut statement = connection.prepare(
+			"SELECT height, block_hash, filter_hash, contents FROM filters WHERE height <= ?1 ORDER BY height")?;
+		let rows = statement.query_map(params![tip], |row| {
+			Ok((row.get::<_, u32>(0)?, row.get::<_, Vec<u8>>(1)?, row.get::<_, Vec<u8>>(2)?, row.get::<_, Vec<u8>>(3)?))
+		})?;
+		let mut result = Vec::new();
+		for row in rows {
+			let (height, bytes, stored_hash, contents) = row?;
+			let hash = BlockHash::from_slice(&bytes).map_err(|_| rusqlite::Error::InvalidQuery)?;
+			if sha256d::Hash::hash(&contents).to_byte_array().as_slice() != stored_hash {
+				return Err(rusqlite::Error::InvalidQuery);
+			}
+			let matched = BlockFilter::new(&contents)
+				.match_any(&hash, scripts.iter().map(|script| script.to_bytes()))
+				.map_err(|_| rusqlite::Error::InvalidQuery)?;
+			if matched { result.push((height, hash)); }
+		}
+		Ok(result)
+	}
+}
+
+struct ChainListener {
+	onchain_wallet: std::sync::Weak<Wallet>,
+	channel_manager: std::sync::Weak<ChannelManager>,
+	chain_monitor: std::sync::Weak<ChainMonitor>,
+	output_sweeper: std::sync::Weak<Sweeper>,
+}
+
+impl ChainListener {
+	fn upgrade(&self) -> Option<(Arc<Wallet>, Arc<ChannelManager>, Arc<ChainMonitor>, Arc<Sweeper>)> {
+		Some((self.onchain_wallet.upgrade()?, self.channel_manager.upgrade()?,
+			self.chain_monitor.upgrade()?, self.output_sweeper.upgrade()?))
+	}
+}
+
+impl Listen for ChainListener {
+	fn filtered_block_connected(&self, header: &bitcoin::block::Header,
+		txdata: &lightning::chain::transaction::TransactionData, height: u32) {
+		if let Some((wallet, manager, monitor, sweeper)) = self.upgrade() {
+			wallet.filtered_block_connected(header, txdata, height);
+			manager.filtered_block_connected(header, txdata, height);
+			monitor.filtered_block_connected(header, txdata, height);
+			sweeper.filtered_block_connected(header, txdata, height);
+		}
+	}
+	fn block_connected(&self, block: &bitcoin::Block, height: u32) {
+		if let Some((wallet, manager, monitor, sweeper)) = self.upgrade() {
+			wallet.block_connected(block, height);
+			manager.block_connected(block, height);
+			monitor.block_connected(block, height);
+			sweeper.block_connected(block, height);
+		}
+	}
+	fn blocks_disconnected(&self, fork: BlockLocator) {
+		if let Some((wallet, manager, monitor, sweeper)) = self.upgrade() {
+			wallet.blocks_disconnected(fork);
+			manager.blocks_disconnected(fork);
+			monitor.blocks_disconnected(fork);
+			sweeper.blocks_disconnected(fork);
+		}
+	}
+}
+
+struct PeerBlockSource {
+	network: Network,
+	requester: RwLock<Option<Requester>>,
+	ready: AtomicBool,
+	stopped: AtomicBool,
+	known_headers: Mutex<HashMap<BlockHash, BlockHeaderData>>,
+	filters: FilterHistory,
+	archive_error: AtomicBool,
+	channel_scripts: Mutex<HashSet<ScriptBuf>>,
+	pending_scripts: Mutex<Vec<(u64, ScriptBuf)>>,
+	watch_version: AtomicU64,
+	synced_watch_version: AtomicU64,
+	wallet: RwLock<std::sync::Weak<Wallet>>,
+	skipped_blocks: AtomicU64,
+	fetched_blocks: AtomicU64,
+}
+
+impl PeerBlockSource {
+	fn new(network: Network, filters: FilterHistory) -> Self {
+		Self { network, requester: RwLock::new(None), ready: AtomicBool::new(false), stopped: AtomicBool::new(false),
+			known_headers: Mutex::new(HashMap::new()), filters, archive_error: AtomicBool::new(false),
+			channel_scripts: Mutex::new(HashSet::new()), pending_scripts: Mutex::new(Vec::new()),
+			watch_version: AtomicU64::new(0), synced_watch_version: AtomicU64::new(0),
+			wallet: RwLock::new(std::sync::Weak::new()),
+			skipped_blocks: AtomicU64::new(0), fetched_blocks: AtomicU64::new(0) }
+	}
+
+	fn watch_script(&self, script: ScriptBuf) {
+		if self.channel_scripts.lock().expect("lock").insert(script.clone()) {
+			let mut pending = self.pending_scripts.lock().expect("lock");
+			let version = self.watch_version.fetch_add(1, Ordering::AcqRel) + 1;
+			pending.push((version, script));
+		}
+	}
+
+	fn mark_watches_synced(&self, version: u64) {
+		self.synced_watch_version.store(version, Ordering::Release);
+		self.pending_scripts.lock().expect("lock").retain(|(v, _)| *v > version);
+	}
+
+	fn scripts_to_watch(&self) -> Result<HashSet<ScriptBuf>, BlockSourceError> {
+		let wallet = self.wallet.read().expect("lock").upgrade().ok_or_else(||
+			BlockSourceError::transient(io::Error::other("Bitcoin wallet is not ready")))?;
+		let mut scripts = self.channel_scripts.lock().expect("lock").clone();
+		scripts.extend(wallet.revealed_scripts());
+		Ok(scripts)
+	}
+
+	fn requester(&self) -> Result<Requester, BlockSourceError> {
+		if !self.ready.load(Ordering::Acquire) {
+			return Err(BlockSourceError::transient(io::Error::other("Bitcoin peer filters are not synchronized")));
+		}
+		self.requester.read().expect("lock").clone().ok_or_else(||
+			BlockSourceError::transient(io::Error::other("Bitcoin peer is not running")))
+	}
+
+	async fn header_at(&self, requester: &Requester, height: u32) -> Result<bitcoin::block::Header, BlockSourceError> {
+		if height == 0 { return Ok(bitcoin::constants::genesis_block(self.network).header); }
+		let indexed = tokio::time::timeout(REQUEST_TIMEOUT, requester.get_header(height)).await
+			.map_err(|_| BlockSourceError::transient(io::Error::other("Bitcoin header request timed out")))?
+			.map_err(BlockSourceError::transient)?
+			.ok_or_else(|| BlockSourceError::transient(io::Error::other(format!("Bitcoin header at height {height} is unavailable"))))?;
+		Ok(indexed.header)
+	}
+}
+
+impl BlockSource for PeerBlockSource {
+	async fn get_header(&self, hash: &BlockHash, height_hint: Option<u32>) -> Result<BlockHeaderData, BlockSourceError> {
+		if let Some(header) = self.known_headers.lock().expect("lock").get(hash).copied() {
+			return Ok(header);
+		}
+		let requester = self.requester()?;
+		let height = match height_hint {
+			Some(height) => height,
+			None => tokio::time::timeout(REQUEST_TIMEOUT, requester.height_of_hash(*hash)).await
+				.map_err(|_| BlockSourceError::transient(io::Error::other("Bitcoin height request timed out")))?
+				.map_err(BlockSourceError::transient)?
+				.ok_or_else(|| BlockSourceError::transient(io::Error::other("Unknown block hash")))?,
+		};
+		let header = self.header_at(&requester, height).await?;
+		if header.block_hash() != *hash {
+			return Err(BlockSourceError::transient(io::Error::other("Bitcoin header changed during a reorganization")));
+		}
+		// Kyoto validates the header chain. LDK's poller additionally needs cumulative work.
+		// This prototype starts at genesis on regtest, where this bounded recomputation is cheap.
+		let mut chainwork = Work::from_be_bytes([0; 32]);
+		for h in 0..=height {
+			chainwork = chainwork + self.header_at(&requester, h).await?.work();
+		}
+		let data = BlockHeaderData { header, height, chainwork };
+		self.known_headers.lock().expect("lock").insert(*hash, data);
+		Ok(data)
+	}
+
+	async fn get_block(&self, hash: &BlockHash) -> Result<BlockData, BlockSourceError> {
+		let (header, filter) = self.filters.get(hash).map_err(BlockSourceError::persistent)?
+			.ok_or_else(|| BlockSourceError::transient(io::Error::other(format!("Bitcoin compact filter for {hash} is unavailable"))))?;
+		let scripts = self.scripts_to_watch()?;
+		let matched = filter.match_any(hash, scripts.iter().map(|script| script.to_bytes()))
+			.map_err(BlockSourceError::persistent)?;
+		if !matched {
+			self.skipped_blocks.fetch_add(1, Ordering::Relaxed);
+			return Ok(BlockData::HeaderOnly(header));
+		}
+		let requester = self.requester()?;
+		let indexed = tokio::time::timeout(REQUEST_TIMEOUT, requester.get_block(*hash)).await
+			.map_err(|_| BlockSourceError::transient(io::Error::other("Bitcoin block request timed out")))?
+			.map_err(BlockSourceError::transient)?;
+		if indexed.block.block_hash() != *hash {
+			return Err(BlockSourceError::persistent(io::Error::other("Bitcoin peer returned a different block")));
+		}
+		self.fetched_blocks.fetch_add(1, Ordering::Relaxed);
+		Ok(BlockData::FullBlock(indexed.block))
+	}
+
+	async fn get_best_block(&self) -> Result<(BlockHash, Option<u32>), BlockSourceError> {
+		let requester = self.requester()?;
+		let tip = tokio::time::timeout(REQUEST_TIMEOUT, requester.chain_tip()).await
+			.map_err(|_| BlockSourceError::transient(io::Error::other("Bitcoin tip request timed out")))?
+			.map_err(BlockSourceError::transient)?;
+		Ok((tip.hash, Some(tip.height)))
+	}
+}
+
+pub(super) struct P2pChainSource {
+	peers: [SocketAddr; 2],
+	block_source: Arc<PeerBlockSource>,
+	spv_client: tokio::sync::Mutex<Option<PeerSpvClient>>,
+	latest_tip: RwLock<Option<ValidatedBlockHeader>>,
+	wallet_polling_status: Mutex<WalletSyncStatus>,
+	fee_estimator: Arc<OnchainFeeEstimator>,
+	config: Arc<Config>,
+	logger: Arc<Logger>,
+	last_logged_counts: Mutex<(u64, u64)>,
+}
+
+impl P2pChainSource {
+	pub(super) fn new(peer: String, fee_estimator: Arc<OnchainFeeEstimator>, config: Arc<Config>, logger: Arc<Logger>) -> Result<Self, ()> {
+		if config.network != Network::Regtest { return Err(()); }
+		let mut addresses = peer.split(',').map(str::trim);
+		let first: SocketAddr = addresses.next().ok_or(())?.parse().map_err(|_| ())?;
+		let second: SocketAddr = addresses.next().ok_or(())?.parse().map_err(|_| ())?;
+		if addresses.next().is_some() || first == second { return Err(()); }
+		let filters = FilterHistory::open(&config.storage_dir_path).map_err(|_| ())?;
+		Ok(Self { peers: [first, second], block_source: Arc::new(PeerBlockSource::new(config.network, filters)), spv_client: tokio::sync::Mutex::new(None),
+			latest_tip: RwLock::new(None), wallet_polling_status: Mutex::new(WalletSyncStatus::Completed),
+			fee_estimator, config, logger, last_logged_counts: Mutex::new((0, 0)) })
+	}
+
+	fn log_filter_counts(&self) {
+		let skipped = self.block_source.skipped_blocks.load(Ordering::Relaxed);
+		let fetched = self.block_source.fetched_blocks.load(Ordering::Relaxed);
+		let mut last = self.last_logged_counts.lock().expect("lock");
+		if *last != (skipped, fetched) {
+			log_info!(self.logger, "Bitcoin compact filters: {} header-only blocks, {} full blocks downloaded", skipped, fetched);
+			*last = (skipped, fetched);
+		}
+	}
+
+	pub(super) fn start(&self, runtime: Arc<Runtime>) {
+		self.block_source.stopped.store(false, Ordering::Release);
+		let source = Arc::clone(&self.block_source);
+		let logger = Arc::clone(&self.logger);
+		let network = self.config.network;
+		let peers = self.peers;
+		runtime.spawn_background_task(async move {
+			loop {
+				if source.stopped.load(Ordering::Acquire) { break; }
+				source.archive_error.store(false, Ordering::Release);
+				let (node, client) = PeerBuilder::new(network).add_peer(peers[0]).add_peer(peers[1]).whitelist_only()
+					.required_peers(2).fetch_witness_data().build();
+				let Client { requester, mut info_rx, mut warn_rx, mut event_rx } = client;
+				*source.requester.write().expect("lock") = Some(requester);
+				let event_source = Arc::clone(&source);
+				let event_task = tokio::spawn(async move {
+					while let Some(event) = event_rx.recv().await {
+						match event {
+							Event::IndexedFilter(filter) => {
+								if event_source.filters.insert(filter).is_err() {
+									event_source.archive_error.store(true, Ordering::Release);
+									event_source.ready.store(false, Ordering::Release);
+									if let Some(requester) = event_source.requester.read().expect("lock").clone() {
+										let _ = requester.shutdown();
+									}
+								}
+							},
+							Event::FiltersSynced(_) => {
+								if !event_source.archive_error.load(Ordering::Acquire) {
+									event_source.ready.store(true, Ordering::Release);
+								}
+							},
+							Event::ChainUpdate(_) => event_source.ready.store(false, Ordering::Release),
+						}
+					}
+				});
+				let info_task = tokio::spawn(async move { while info_rx.recv().await.is_some() {} });
+				let warn_task = tokio::spawn(async move { while warn_rx.recv().await.is_some() {} });
+				let result = node.run().await;
+				source.ready.store(false, Ordering::Release);
+				*source.requester.write().expect("lock") = None;
+				event_task.abort();
+				info_task.abort();
+				warn_task.abort();
+				if source.stopped.load(Ordering::Acquire) { break; }
+				if let Err(error) = result {
+					log_error!(logger, "Bitcoin peer stopped; reconnecting: {}", error);
+				}
+				tokio::time::sleep(RETRY_DELAY).await;
+			}
+		});
+	}
+
+	pub(super) fn stop(&self) {
+		self.block_source.stopped.store(true, Ordering::Release);
+		self.block_source.ready.store(false, Ordering::Release);
+		if let Some(requester) = self.block_source.requester.write().expect("lock").take() {
+			let _ = requester.shutdown();
+		}
+	}
+
+	pub(super) fn register_tx(&self, script: &bitcoin::Script) {
+		self.block_source.watch_script(script.to_owned());
+	}
+
+	pub(super) fn register_output(&self, output: lightning::chain::WatchedOutput) {
+		self.block_source.watch_script(output.script_pubkey);
+	}
+
+	pub(super) async fn continuously_sync_wallets(&self, mut stop: tokio::sync::watch::Receiver<()>, wallet: Arc<Wallet>,
+		manager: Arc<ChannelManager>, monitor: Arc<ChainMonitor>, sweeper: Arc<Sweeper>) {
+		loop {
+			if stop.has_changed().unwrap_or(true) { return; }
+			let _ = self.poll_and_update_listeners(Arc::clone(&wallet), Arc::clone(&manager), Arc::clone(&monitor), Arc::clone(&sweeper)).await;
+			tokio::select! { _ = stop.changed() => return, _ = tokio::time::sleep(RETRY_DELAY) => {} }
+		}
+	}
+
+	async fn initial_sync(&self, wallet: Arc<Wallet>, manager: Arc<ChannelManager>, monitor: Arc<ChainMonitor>, sweeper: Arc<Sweeper>) -> Result<(), Error> {
+		if !self.block_source.ready.load(Ordering::Acquire) { return Err(Error::ConnectionFailed); }
+		let watch_version = self.block_source.watch_version.load(Ordering::Acquire);
+		let mut listeners = vec![
+			(wallet.current_best_block(), &*wallet as &(dyn Listen + Send + Sync)),
+			(manager.current_best_block(), &*manager as &(dyn Listen + Send + Sync)),
+			(sweeper.current_best_block(), &*sweeper as &(dyn Listen + Send + Sync)),
+		];
+		if let Some(worst) = monitor.list_monitors().iter().flat_map(|id| monitor.get_monitor(*id))
+			.map(|item| item.current_best_block()).min_by_key(|block| block.height) {
+			listeners.push((worst, &*monitor as &(dyn Listen + Send + Sync)));
+		}
+		let (cache, tip) = synchronize_listeners(self.block_source.as_ref(), self.config.network, listeners)
+			.await.map_err(|error| { log_error!(self.logger, "Bitcoin peer initial sync failed: {:?}", error); Error::TxSyncFailed })?;
+		let listener = Arc::new(ChainListener { onchain_wallet: Arc::downgrade(&wallet), channel_manager: Arc::downgrade(&manager),
+			chain_monitor: Arc::downgrade(&monitor), output_sweeper: Arc::downgrade(&sweeper) });
+		let poller = ChainPoller::new(Arc::clone(&self.block_source), self.config.network);
+		*self.spv_client.lock().await = Some(SpvClient::new(tip, poller, cache, listener));
+		*self.latest_tip.write().expect("lock") = Some(tip);
+		self.block_source.mark_watches_synced(watch_version);
+		log_info!(self.logger, "Direct Bitcoin peer initial sync complete at height {}", tip.height);
+		self.log_filter_counts();
+		Ok(())
+	}
+
+	pub(super) async fn poll_and_update_listeners(&self, wallet: Arc<Wallet>, manager: Arc<ChannelManager>,
+		monitor: Arc<ChainMonitor>, sweeper: Arc<Sweeper>) -> Result<(), Error> {
+		let receiver = self.wallet_polling_status.lock().expect("lock").register_or_subscribe_pending_sync();
+		if let Some(mut receiver) = receiver { return receiver.recv().await.map_err(|_| Error::WalletOperationFailed)?; }
+		let guard = WalletSyncGuard::new(&self.wallet_polling_status, Error::WalletOperationFailed);
+		let result = self.poll_inner(wallet, manager, monitor, sweeper).await;
+		guard.complete(result);
+		result
+	}
+
+	async fn poll_inner(&self, wallet: Arc<Wallet>, manager: Arc<ChannelManager>, monitor: Arc<ChainMonitor>, sweeper: Arc<Sweeper>) -> Result<(), Error> {
+		*self.block_source.wallet.write().expect("lock") = Arc::downgrade(&wallet);
+		if !self.block_source.ready.load(Ordering::Acquire) { return Err(Error::ConnectionFailed); }
+		if self.spv_client.lock().await.is_none() { self.initial_sync(Arc::clone(&wallet), Arc::clone(&manager), Arc::clone(&monitor), Arc::clone(&sweeper)).await?; }
+		let mut client = self.spv_client.lock().await;
+		match client.as_mut().expect("initial sync").poll_best_tip().await {
+			Ok((ChainTip::Better(tip), true)) => *self.latest_tip.write().expect("lock") = Some(tip),
+			Ok(_) => {},
+			Err(error) => { log_error!(self.logger, "Bitcoin peer chain polling failed: {:?}", error); return Err(Error::TxSyncFailed); },
+		}
+		drop(client);
+		self.replay_new_watches(&wallet, &manager, &monitor, &sweeper).await?;
+		self.log_filter_counts();
+		Ok(())
+	}
+
+	async fn replay_new_watches(&self, wallet: &Arc<Wallet>, manager: &Arc<ChannelManager>,
+		monitor: &Arc<ChainMonitor>, sweeper: &Arc<Sweeper>) -> Result<(), Error> {
+		let synced = self.block_source.synced_watch_version.load(Ordering::Acquire);
+		let version = self.block_source.watch_version.load(Ordering::Acquire);
+		if version == synced { return Ok(()); }
+		let scripts: Vec<_> = self.block_source.pending_scripts.lock().expect("lock").iter()
+			.filter(|(v, _)| *v > synced && *v <= version).map(|(_, script)| script.clone()).collect();
+		let tip = self.latest_tip.read().expect("lock").ok_or(Error::TxSyncFailed)?;
+		let requester = self.block_source.requester().map_err(|_| Error::ConnectionFailed)?;
+		let candidates = self.block_source.filters.matches(&scripts, tip.height)
+			.map_err(|_| Error::TxSyncFailed)?;
+		let mut earliest = None;
+		for (height, hash) in candidates {
+			let header = self.block_source.header_at(&requester, height).await.map_err(|_| Error::TxSyncFailed)?;
+			if header.block_hash() != hash { continue; }
+			let block = match self.block_source.get_block(&hash).await.map_err(|_| Error::TxSyncFailed)? {
+				BlockData::FullBlock(block) if block.check_merkle_root() && block.check_witness_commitment() => block,
+				_ => return Err(Error::TxSyncFailed),
+			};
+			wallet.apply_historical_block(&block, height).await?;
+			let txdata: Vec<_> = block.txdata.iter().enumerate().collect();
+			manager.transactions_confirmed(&block.header, &txdata, height);
+			monitor.transactions_confirmed(&block.header, &txdata, height);
+			sweeper.transactions_confirmed(&block.header, &txdata, height);
+			earliest.get_or_insert(height);
+		}
+		self.block_source.mark_watches_synced(version);
+		if let Some(height) = earliest {
+			log_info!(self.logger, "Bitcoin watch replayed from height {} through {}", height, tip.height);
+		}
+		Ok(())
+	}
+
+	pub(super) async fn update_fee_rate_estimates(&self) -> Result<(), Error> {
+		let rate = FeeRate::from_sat_per_kwu(250);
+		let fees = get_all_conf_targets().into_iter().map(|target| (target, apply_post_estimation_adjustments(target, rate))).collect();
+		self.fee_estimator.set_fee_rate_cache(fees);
+		Ok(())
+	}
+
+	pub(super) async fn process_transaction_broadcast(&self, txs: SortedTransactions) {
+		let transactions = txs.into_inner();
+		if transactions.len() <= 2 {
+			match Package::from_vec(transactions.clone()) {
+				Ok(package) => { self.send_package(package).await; return; },
+				Err(error) => log_error!(self.logger, "Invalid Bitcoin broadcast package: {:?}", error),
+			}
+		}
+		for tx in transactions { self.send_package(Package::new_single(tx)).await; }
+	}
+
+	async fn send_package(&self, package: Package) {
+		loop {
+			if self.block_source.stopped.load(Ordering::Acquire) {
+				log_error!(self.logger, "Bitcoin peer stopped before transaction could be broadcast");
+				return;
+			}
+			if let Ok(requester) = self.block_source.requester() {
+				match tokio::time::timeout(REQUEST_TIMEOUT, requester.submit_package(package.clone())).await {
+					Ok(Ok(_)) => return,
+					other => log_error!(self.logger, "Bitcoin peer broadcast failed; retrying: {:?}", other),
+				}
+			}
+			tokio::time::sleep(RETRY_DELAY).await;
+		}
+	}
+}
